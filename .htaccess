RewriteRule ^electrical/SmokeDetectorInstallationServices/?$ /electrical/smoke-detector-installation-services [R=301,L]
RewriteRule ^electrical/SolarPowerandWallBatteryInstallation/?$ /electrical/solar-power-and-wall-battery-installation [R=301,L]
RewriteRule ^electrical/SurgeProtectionInstallation/?$ /electrical/surge-protection-installation [R=301,L]
RewriteRule ^electrical/SwitchOutletinstallationReplacement/?$ /electrical/switch-outlet-installation-replacement [R=301,L]
RewriteRule ^hvac/AirConditionerInstallation/?$ /hvac/air-conditioner-installation [R=301,L]
RewriteRule ^hvac/CommercialHVAC/?$ /hvac/commercial-hvac [R=301,L]
RewriteRule ^hvac/DualfuelsysteminstallationFurnaceHeatPump/?$ /hvac/dual-fuel-system-installation-furnace-heat-pump [R=301,L]
RewriteRule ^hvac/DuctlessMiniSplitInstallation/?$ /hvac/ductless-mini-split-installation [R=301,L]
RewriteRule ^hvac/DuctworkInstallation/?$ /hvac/ductwork-installation [R=301,L]
RewriteRule ^hvac/FurnaceInstallation/?$ /hvac/furnace-installation [R=301,L]
RewriteRule ^hvac/HeatPumpInstallation/?$ /hvac/heat-pump-installation [R=301,L]
RewriteRule ^hvac/HydronicSystem/?$ /hvac/hydronic-system [R=301,L]
RewriteRule ^hvac/RadiantHeating/?$ /hvac/radiant-heating [R=301,L]
RewriteRule ^hvac/RooftopPackageUnitInstallation/?$ /hvac/rooftop-package-unit-installation [R=301,L]
RewriteRule ^hvac/ZoningSystem/?$ /hvac/zoning-system [R=301,L]
RewriteRule ^plumbing/BackflowTestingandPrevention/?$ /plumbing/backflow-testing-and-prevention [R=301,L]
RewriteRule ^plumbing/CommercialPlumbingservices/?$ /plumbing/commercial-plumbing-services [R=301,L]
RewriteRule ^plumbing/DrainCleaningServices/?$ /plumbing/drain-cleaning-services [R=301,L]
RewriteRule ^plumbing/EmergencyBurstPipeRepair/?$ /plumbing/emergency-burst-pipe-repair [R=301,L]
RewriteRule ^plumbing/EmergencyWaterHeaterRepair/?$ /plumbing/emergency-water-heater-repair [R=301,L]
RewriteRule ^plumbing/HydroJettingServices/?$ /plumbing/hydro-jetting-services [R=301,L]
RewriteRule ^plumbing/LeakDetectionServices/?$ /plumbing/leak-detection-services [R=301,L]
RewriteRule ^plumbing/LeakRepairServices/?$ /plumbing/leak-repair-services [R=301,L]
RewriteRule ^plumbing/PipeRepairsandRepiping/?$ /plumbing/pipe-repairs-and-repiping [R=301,L]
RewriteRule ^plumbing/SewerLineServices/?$ /plumbing/sewer-line-services [R=301,L]
RewriteRule ^plumbing/SumpPumpInstallationRepair/?$ /plumbing/sump-pump-installation-repair [R=301,L]
RewriteRule ^plumbing/WaterHeaterInstallation/?$ /plumbing/water-heater-installation [R=301,L]
RewriteRule ^plumbing/WaterHeaterReplacement/?$ /plumbing/water-heater-replacement [R=301,L]

# Force canonical homepage URL
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[\s?]|$) [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# Allow direct file and directory access
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Remove trailing .html from URLs
RewriteCond %{THE_REQUEST} \s/+(.*)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Serve .html when extensionless URL is requested
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/?$ $1.html [L]

# Map root to index.html
RewriteRule ^$ index.html [L]
