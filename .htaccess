RewriteEngine On

# Redirect old typo'd URLs to their fixed permanent homes
RewriteRule ^rebaits/?$ /rebates [R=301,L]
RewriteRule ^electrical/BackupEnergySystemsandGeneratorIstallation/?$ /electrical/BackupEnergySystemsandGeneratorInstallation [R=301,L]


# 301 redirects: old CamelCase service URLs -> kebab-case
RewriteRule ^electrical/240VInstallationforSaunaHotTub/?$ /electrical/240v-installation-for-sauna-hot-tub [R=301,L]
RewriteRule ^electrical/247EmergencyElectricalServices/?$ /electrical/24-7-emergency-electrical-services [R=301,L]
